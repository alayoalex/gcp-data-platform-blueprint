  "tables": [
    {
      "target": {
        "database": "novamarket-data-prod-c3d4",
        "schema": "commerce_silver",
        "name": "mst_customer"
      },
      "type": "table",
      "fileName": "definitions/silver/mst_customer.sqlx",
      "tags": [
        "silver",
        "hourly"
      ],
      "bigquery": {
        "labels": {
          "layer": "silver",
          "product": "novamarket-commerce"
        }
      },
      "actionDescriptor": {
        "description": "Maestro de clientes seudonimizado. Un registro por cuenta, con los atributos que la analitica necesita y ninguno que identifique a la persona.",
        "columns": [
          {
            "path": [
              "customer_key"
            ],
            "description": "Clave seudonimizada y estable de la cuenta. Es la llave de union con el resto del modelo."
          },
          {
            "path": [
              "email_domain_name"
            ],
            "description": "Dominio del correo de la cuenta, sin la parte local."
          },
          {
            "path": [
              "customer_city_name"
            ],
            "description": "Ciudad o comuna declarada en el perfil de despacho."
          },
          {
            "path": [
              "customer_region_name"
            ],
            "description": "Region declarada en el perfil de despacho."
          },
          {
            "path": [
              "customer_country_code"
            ],
            "description": "Pais del perfil en formato ISO 3166-1 alfa-2."
          },
          {
            "path": [
              "has_phone_flag"
            ],
            "description": "Indica si la cuenta tiene telefono registrado."
          },
          {
            "path": [
              "has_complete_profile_flag"
            ],
            "description": "Indica si el perfil tiene ciudad, region y pais informados."
          },
          {
            "path": [
              "is_active_flag"
            ],
            "description": "Indica si la cuenta esta activa en el sistema de origen."
          },
          {
            "path": [
              "account_created_date"
            ],
            "description": "Dia de creacion de la cuenta."
          },
          {
            "path": [
              "account_updated_datetime"
            ],
            "description": "Momento de la ultima modificacion de la cuenta en el origen."
          },
          {
            "path": [
              "ingestion_datetime"
            ],
            "description": "Momento en que la plataforma ingesto la fila (UTC)."
          }
        ]
      }
    },
