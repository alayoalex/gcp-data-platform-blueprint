          {
            "path": [
              "sale_date"
            ],
            "description": "Dia calendario de la venta en zona horaria America/Santiago."
          },
          {
            "path": [
              "product_key"
            ],
            "description": "Identificador del producto vendido."
          },
          {
            "path": [
              "product_name"
            ],
            "description": "Nombre comercial del producto."
          },
          {
            "path": [
              "department_name"
            ],
            "description": "Categoria gruesa del catalogo."
          },
          {
            "path": [
              "order_quantity"
